{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!convex/_generated",
			"!.next",
			"!node_modules",
			"!public/**/*.svg"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noSvgWithoutTitle": "off",
				"useButtonType": "off",
				"useSemanticElements": "warn",
				"noStaticElementInteractions": "warn",
				"useKeyWithClickEvents": "warn",
				"useFocusableInteractive": "warn",
				"useAriaPropsSupportedByRole": "warn",
				"useAriaPropsForRole": "warn",
				"noRedundantRoles": "warn"
			},
			"performance": {
				"noImgElement": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noArrayIndexKey": "warn",
				"noDocumentCookie": "warn"
			},
			"correctness": {
				"useExhaustiveDependencies": "warn",
				"noUnusedFunctionParameters": "warn",
				"noUnusedVariables": "error",
				"noUnusedImports": "error",
				"useParseIntRadix": "error"
			},
			"security": {
				"noDangerouslySetInnerHtml": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/components/ui/**"],
			"linter": {
				"rules": {
					"a11y": {
						"preset": "none"
					},
					"suspicious": {
						"noArrayIndexKey": "off"
					},
					"correctness": {
						"noUnusedFunctionParameters": "off",
						"useExhaustiveDependencies": "off"
					}
				}
			}
		},
		{
			"includes": ["convex/**"],
			"linter": {
				"rules": {
					"style": {
						"useNodejsImportProtocol": "off"
					}
				}
			}
		},
		{
			"includes": ["src/app/error.tsx"],
			"linter": {
				"rules": {
					"suspicious": {
						"noShadowRestrictedNames": "off"
					}
				}
			}
		},
		{
			"includes": ["src/app/opengraph-image.tsx", "src/lib/og/**"],
			"linter": {
				"rules": {
					"a11y": {
						"useAltText": "off"
					}
				}
			}
		}
	],
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
