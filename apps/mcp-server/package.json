{
	"name": "@byronwade/memoria",
	"version": "1.1.0",
	"description": "The Memory Your AI Lacks - MCP server giving AI Senior Developer Intuition through git forensics",
	"type": "module",
	"main": "dist/index.js",
	"module": "./src/index.ts",
	"bin": {
		"memoria": "dist/cli.js",
		"memoria-server": "dist/index.js"
	},
	"files": [
		"dist",
		"rules",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc",
		"start": "node dist/index.js",
		"dev": "tsc --watch",
		"lint": "echo \"No lint configured\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"benchmark:ci": "node scripts/ci-benchmark.mjs",
		"prepublishOnly": "npm run build && npm test"
	},
	"keywords": [
		"mcp",
		"git",
		"memoria",
		"memory",
		"forensics",
		"code-analysis",
		"model-context-protocol",
		"ai-tools"
	],
	"author": "Byron Wade",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/byronwade/memoria.git"
	},
	"homepage": "https://github.com/byronwade/memoria",
	"bugs": {
		"url": "https://github.com/byronwade/memoria/issues"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"knip": {
		"ignore": [
			"benchmarks/**"
		]
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@clack/prompts": "^1.7.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@smithery/sdk": "^4.3.0",
		"chalk": "^6.0.0",
		"ignore": "^7.0.6",
		"lru-cache": "^11.5.2",
		"simple-git": "^3.36.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"typescript": "~5.9.3",
		"vitest": "^4.1.10"
	}
}
